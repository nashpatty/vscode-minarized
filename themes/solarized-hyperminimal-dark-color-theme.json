    "name": "Solarized Min Dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "customLiteral": "#93a1a1",
        "newOperator": "#93a1a1",
        "numberLiteral": "#d33682",
        "stringLiteral": "#2aa198"
    },
    "tokenColors": [
        {
            "name": "remove highlights",
            "scope": [
                "entity.name.variable"
            ],
            "settings": {
                "foreground": "#93a1a1"
            }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#cb4b16"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.regexp",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#859900"
            }
        },
        {
            "name": "Strings: Escape Sequences",
            "scope": "constant.character.escape",
            "settings": {
                "foreground": "#657b83"
            }
        },
        {
            "name": "Numbers, Characters",
            "scope": [
                "constant.numeric",
                "constant.character",
                "constant.keyword",
                "constant"
            ],
            "settings": {
                "foreground": "#d33682"
            }
        },
        {
            "name": "Global definitions",
            "scope": "entity.name,support.function",
            "settings": {
                "foreground": "#b58900"
            }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation,meta.brace",
            "settings": {
                "foreground": "#657b83"
            }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "foreground": "#dc322f"
            }
        }
    ]
}