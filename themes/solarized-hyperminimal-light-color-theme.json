    "name": "Solarized Min Light",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "customLiteral": "#586e75",
        "newOperator": "#586e75",
        "numberLiteral": "#d33682",
        "stringLiteral": "#2aa198"
    },
    "tokenColors": [
        {
            "name": "remove highlights",
            "scope": [
                "entity.name.variable"
            ],
            "settings": {
                "foreground": "#586e75"
            }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#cb4b16"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.regexp",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#2aa198"
            }
        },
        {
            "name": "Strings: Escape Sequences",
            "scope": "constant.character.escape",
            "settings": {
                "foreground": "#839496"
            }
        },
        {
            "name": "Numbers, Characters",
            "scope": [
                "constant.numeric",
                "constant.character",
                "constant.keyword",
                "constant"
            ],
            "settings": {
                "foreground": "#d33682"
            }
        },
        {
            "name": "Global definitions",
            "scope": "entity.name,support.function",
            "settings": {
                "foreground": "#268bd2"
            }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation,meta.brace",
            "settings": {
                "foreground": "#93a1a1"
            }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "foreground": "#dc322f"
            }
        }
    ]
}